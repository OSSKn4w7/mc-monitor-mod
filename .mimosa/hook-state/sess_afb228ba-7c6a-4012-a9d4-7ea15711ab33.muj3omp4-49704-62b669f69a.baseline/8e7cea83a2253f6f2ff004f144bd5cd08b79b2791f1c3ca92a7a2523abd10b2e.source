package com.osskn4w7.mcmonitor.harness;

import com.osskn4w7.mcmonitor.core.auth.PasswordAuth;
import com.osskn4w7.mcmonitor.core.server.MonitorBackend;
import com.osskn4w7.mcmonitor.core.server.MonitorServer;

import javax.imageio.ImageIO;
import java.awt.Color;
import java.awt.Font;
import java.awt.Graphics2D;
import java.awt.image.BufferedImage;
import java.io.BufferedInputStream;
import java.io.ByteArrayOutputStream;
import java.io.DataInputStream;
import java.io.DataOutputStream;
import java.net.InetAddress;
import java.net.ServerSocket;
import java.net.Socket;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.Base64;
import java.util.List;
import java.util.concurrent.Executors;
import java.util.concurrent.ScheduledExecutorService;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;

// 本地测试后端：不起 Minecraft，验证 App<->核心 全链路。
// 同时内置一个 Minecraft SLP（Server List Ping）应答器，用于验证 App 的直连查询协议。
// 用法: Harness [monitorPort] [password]
public final class Harness {

    public static void main(String[] args) throws Exception {
        int port = args.length > 0 ? Integer.parseInt(args[0]) : 25580;
        String password = args.length > 1 ? args[1] : "Steady-Wolf.42";

        // 每次启动都重新生成验证器，保证测试密码与参数一致
        Path authFile = Path.of("harness-auth.json");
        Files.deleteIfExists(authFile);
        PasswordAuth auth = new PasswordAuth(authFile);
        auth.set(password);

        long start = System.currentTimeMillis();
        MonitorBackend backend = new MonitorBackend() {
            @Override
            public StatusInfo status() {
                return new StatusInfo(
                    3, 20,
                    List.of("osskn4w7", "Alice", "Steve"),
                    19.97,
                    (System.currentTimeMillis() - start) / 1000,
                    "1.21.1 (测试后端)"
                );
            }

            @Override
            public String runCommand(String command) {
                return "已执行(测试后端): " + command + "\n当前在线 3 人: osskn4w7, Alice, Steve";
            }
        };

        MonitorServer server = new MonitorServer(port, "0.0.0.0", auth, backend);
        server.start();

        AtomicInteger counter = new AtomicInteger();
        ScheduledExecutorService ses = Executors.newSingleThreadScheduledExecutor(r -> {
            Thread t = new Thread(r, "harness-fake-logs");
            t.setDaemon(true);
            return t;
        });
        ses.scheduleAtFixedRate(() -> {
            int n = counter.incrementAndGet();
            server.publishLog("[INFO] 测试后端: 心跳 #" + n + " TPS=19.97 在线=3");
        }, 3, 5, TimeUnit.SECONDS);

        System.out.println("HARNESS-READY port=" + port);
        System.out.println("测试密码: " + password);

        // SLP 应答器：默认 25565，模拟真服务器供 App 直连查询
        int slpPort = args.length > 2 ? Integer.parseInt(args[2]) : 25565;
        Thread slp = new Thread(() -> slpServer(slpPort), "harness-slp");
        slp.setDaemon(true);
        slp.start();
        System.out.println("SLP-READY port=" + slpPort);

        Thread.currentThread().join();
    }

    // ---------- Minecraft Server List Ping 应答 ----------
    private static void slpServer(int port) {
        try (ServerSocket ss = new ServerSocket(port, 16, InetAddress.getByName("0.0.0.0"))) {
            while (true) {
                Socket s = ss.accept();
                new Thread(() -> handleSlp(s), "slp-conn").start();
            }
        } catch (Exception e) {
            System.out.println("SLP 启动失败: " + e.getMessage());
        }
    }

    private static void handleSlp(Socket socket) {
        try (socket;
             DataInputStream in = new DataInputStream(new BufferedInputStream(socket.getInputStream()));
             DataOutputStream out = new DataOutputStream(new BufferedOutputStream(socket.getOutputStream()))) {
            readPacket(in); // handshake（内容不需要）
            readPacket(in); // status request
            byte[] body = statusBody();
            sendPacket(out, body);
            try {
                byte[] ping = readPacket(in); // ping (0x01 + long)
                if (ping.length > 0 && ping[0] == 0x01) sendPacket(out, ping); // pong 原样返回
            } catch (Exception ignored) {
            }
        } catch (Exception ignored) {
        }
    }

    private static byte[] statusBody() throws Exception {
        String json = "{\"version\":{\"name\":\"1.21.1 (测试后端)\"},"
            + "\"players\":{\"online\":3,\"max\":20},"
            + "\"description\":{\"text\":\"MC 监控测试服务器\\n直连查询协议演示\"},"
            + "\"favicon\":\"" + iconDataUri() + "\"}";
        ByteArrayOutputStream body = new ByteArrayOutputStream();
        DataOutputStream b = new DataOutputStream(body);
        writeVarInt(b, 0x00);
        byte[] jb = json.getBytes(java.nio.charset.StandardCharsets.UTF_8);
        writeVarInt(b, jb.length);
        b.write(jb);
        return body.toByteArray();
    }

    private static String iconDataUri() throws Exception {
        BufferedImage img = new BufferedImage(64, 64, BufferedImage.TYPE_INT_RGB);
        Graphics2D g = img.createGraphics();
        g.setColor(new Color(46, 125, 50));
        g.fillRect(0, 0, 64, 64);
        g.setColor(Color.WHITE);
        g.setFont(new Font("SansSerif", Font.BOLD, 26));
        g.drawString("MC", 13, 42);
        g.dispose();
        ByteArrayOutputStream png = new ByteArrayOutputStream();
        ImageIO.write(img, "png", png);
        return "data:image/png;base64," + Base64.getEncoder().encodeToString(png.toByteArray());
    }

    private static void sendPacket(DataOutputStream out, byte[] body) throws Exception {
        out.writeVarInt(body.length);
        out.write(body);
        out.flush();
    }

    private static byte[] readPacket(DataInputStream in) throws Exception {
        byte[] payload = new byte[readVarInt(in)];
        in.readFully(payload);
        return payload;
    }

    private static int readVarInt(DataInputStream in) throws Exception {
        int value = 0;
        int shift = 0;
        while (true) {
            int b = in.readUnsignedByte();
            value |= (b & 0x7F) << shift;
            if ((b & 0x80) == 0) return value;
            shift += 7;
            if (shift > 35) throw new IllegalStateException("VarInt 过长");
        }
    }

    private static void writeVarInt(DataOutputStream out, int v) throws Exception {
        int value = v;
        while (true) {
            if ((value & 0xFFFFFF80) == 0) {
                out.writeByte(value);
                return;
            }
            out.writeByte((value & 0x7F) | 0x80);
            value >>>= 7;
        }
    }
}
